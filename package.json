{
  "name": "lingyun-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "package:vsix": "turbo run package --filter=lingyun",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "diff@>=6.0.0 <8.0.3": "8.0.4",
      "flatted@<=3.4.1": "3.4.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "qs": "6.14.1",
      "serialize-javascript@<7.0.5": "7.0.5"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.7.4"
  }
}
